# Local access by default. Copy to .env to change configuration.
HOST=192.168.0.10
PORT=3000
# For LAN, set HOST=0.0.0.0 and ALLOWED_HOSTS to the server IP/hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.10
# For Internet access, set the exact HTTPS origin of your reverse proxy.
# PUBLIC_ORIGIN=https://watch.example.com
# DATA_DIR=.data
# MAX_FILE_BYTES=4294967296
# MAX_STORAGE_BYTES=10737418240
# ROOM_TTL_HOURS=24
